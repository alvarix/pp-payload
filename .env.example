# Copy this file to .env and fill in real values. Do not commit .env.

# Database - Supabase Postgres connection string.
# Dashboard: Settings -> Database -> Connection string -> URI.
# Use the pooled connection (port 6543) on Vercel; direct (5432) for local/migrations.
DATABASE_URL=postgres://postgres:password@db.project.supabase.co:5432/postgres

# Payload
# Used to sign session tokens. Generate once: `openssl rand -hex 32`
PAYLOAD_SECRET=replace-me

# Used by data_import/ scripts when running them against a local dev server.
# Not required for the app itself; only for CLI imports.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Supabase Storage - fill in when the storage plugin lands.
# Dashboard: Storage -> Settings -> S3 Connection.
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=us-east-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_BUCKET=media

# Stripe - fill in when Stripe prefill lands.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
