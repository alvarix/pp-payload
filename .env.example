# Copy this file to .env and fill in real values. Do not commit .env.

# Database - Supabase Postgres connection string.
#
# LOCAL DEV: use the direct connection (port 5432).
#   Dashboard -> Settings -> Database -> Connection string -> URI (direct)
#   postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres
#
# VERCEL (production/preview): use the transaction-mode pooler (port 6543).
#   Dashboard -> Settings -> Database -> Connection pooling -> Transaction mode
#   postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#   Transaction mode avoids the 15-connection session-pool cap on serverless.
#
# MIGRATIONS (pnpm payload migrate): always use the direct connection.
#   If Vercel DATABASE_URL is the pooler, run migrations locally with the direct URL.
DATABASE_URL=postgres://postgres:password@db.project.supabase.co:5432/postgres

# Payload
# Used to sign session tokens. Generate once: `openssl rand -hex 32`
PAYLOAD_SECRET=replace-me

# Used by data_import/ scripts when running them against a local dev server.
# Not required for the app itself; only for CLI imports.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Supabase Storage - required; media uploads write to the bucket.
# Dashboard: Storage -> Settings -> S3 Connection (click "Reveal" for keys).
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=media

# Stripe - fill in when Stripe prefill lands.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Brevo - transactional email for admin notifications.
# Dashboard -> SMTP & API -> API Keys
# Sending domain (petportraits.ink) must be verified under Senders & IPs -> Domains.
BREVO_API_KEY=xkeysib-...
